' ===========================================================================
'  run-bridge.vbs  --  hidden launcher for run-bridge.cmd (TEMPLATE)
' ---------------------------------------------------------------------------
'  requires elevation? NO.
'
'  Launches run-bridge.cmd with NO visible console window (WScript.Shell.Run
'  window style 0). Used by the Startup-folder shortcut and as a quiet entry
'  point so the bridge does not flash a cmd window at logon.
'
'  Written as UTF-16LE by addin-install.ps1 so exact profile paths survive
'  Windows PowerShell 5.1 regardless of the active ANSI code page.
' ===========================================================================

Option Explicit

Dim shell, cmdPath, processEnvironment
Set shell = CreateObject("WScript.Shell")
Set processEnvironment = shell.Environment("Process")

processEnvironment("INSTALL_DIR") = "__INSTALL_DIR__"
processEnvironment("HERMES_EXCEL_DATA_DIR") = "__DATA_DIR__"
processEnvironment("HERMES_HOME") = "__HERMES_HOME__"
processEnvironment("HERMES_CONFIG") = "__HERMES_CONFIG__"
processEnvironment("HERMES_EXCEL_PROFILE_NAME") = "__PROFILE_NAME__"
processEnvironment("HERMES_EXCEL_OWNER_RECEIPT") = "__OWNER_RECEIPT__"
processEnvironment("HERMES_EXCEL_OWNER_FINGERPRINT") = "__OWNER_FINGERPRINT__"

cmdPath = "__INSTALL_DIR__\run-bridge.cmd"

' Arg 1: command, Arg 2: window style 0 (hidden), Arg 3: bWaitOnReturn = False
' Quote the path in case the install dir contains spaces.
shell.Run """" & cmdPath & """", 0, False

Set processEnvironment = Nothing
Set shell = Nothing

@echo off
REM ===========================================================================
REM  run-bridge.cmd  --  Hermes for Excel local bridge launcher (TEMPLATE)
REM ---------------------------------------------------------------------------
REM  requires elevation? NO. Per-user, runs entirely under %LOCALAPPDATA%.
REM
REM  This file is a TEMPLATE. addin-install.ps1 copies it to the install dir
REM  and substitutes the __PLACEHOLDER__ tokens below with real values:
REM      __PORT__          bridge port (default 8788)
REM      __PROFILE_NAME__   normalized selected profile name
REM      __OWNER_FINGERPRINT__ non-secret SHA-256 receipt identity
REM  Profile paths are inherited from a UTF-16 VBS launcher or derived from
REM  %~dp0/%LOCALAPPDATA%, so this CMD remains ASCII-safe on Windows PowerShell
REM  5.1 even when the selected profile path contains non-ASCII characters.
REM  Tokens are read at runtime from ACL-restricted profile data files.
REM      __DOCLING_MODE__  wsl | native | docker
REM      __WSL_DISTRO__    WSL distro name (e.g. Ubuntu-24.04)
REM
REM  It sets the env the hardened server.mjs reads, KILLS any stale bridge that
REM  was launched from this same install dir (the load-bearing "stale-bridge
REM  killer" -- a relative path here reintroduces the documented
REM  "re-run strands the old bridge" bug), then launches node on the ABSOLUTE
REM  server.mjs path.
REM ===========================================================================

setlocal

if not defined INSTALL_DIR set "INSTALL_DIR=%~dp0"
if "%INSTALL_DIR:~-1%"=="\" set "INSTALL_DIR=%INSTALL_DIR:~0,-1%"
set "PORT=__PORT__"
if not defined HERMES_EXCEL_DATA_DIR set "HERMES_EXCEL_DATA_DIR=%INSTALL_DIR%\data"
if not defined HERMES_HOME for %%I in ("%INSTALL_DIR%\..") do set "HERMES_HOME=%%~fI"
if not defined HERMES_CONFIG set "HERMES_CONFIG=%HERMES_HOME%\config.yaml"
if not defined HERMES_EXCEL_PROFILE_NAME set "HERMES_EXCEL_PROFILE_NAME=__PROFILE_NAME__"
if not defined HERMES_EXCEL_OWNER_RECEIPT set "HERMES_EXCEL_OWNER_RECEIPT=%LOCALAPPDATA%\hermes\shared\excel-sidecar\owner-v1.json"
if not defined HERMES_EXCEL_OWNER_FINGERPRINT set "HERMES_EXCEL_OWNER_FINGERPRINT=__OWNER_FINGERPRINT__"
set "HERMES_EXCEL_BRIDGE_TOKEN="
set "HERMES_EXCEL_INGEST_TOKEN="
if not exist "%HERMES_EXCEL_DATA_DIR%\.bridge-token" exit /b 1
if not exist "%HERMES_EXCEL_DATA_DIR%\.ingest-token" exit /b 1
set /p HERMES_EXCEL_BRIDGE_TOKEN=<"%HERMES_EXCEL_DATA_DIR%\.bridge-token"
set /p HERMES_EXCEL_INGEST_TOKEN=<"%HERMES_EXCEL_DATA_DIR%\.ingest-token"
powershell -NoProfile -Command "if ($env:HERMES_EXCEL_BRIDGE_TOKEN -notmatch '^[0-9a-f]{64}$' -or $env:HERMES_EXCEL_INGEST_TOKEN -notmatch '^[0-9a-f]{64}$') { exit 1 }"
if errorlevel 1 exit /b 1
set "HERMES_EXCEL_TRANSPORT=platform-only"
set "HERMES_EXCEL_ALLOW_RAW_FALLBACK=0"
set "HERMES_EXCEL_DOCLING_MODE=__DOCLING_MODE__"
set "HERMES_EXCEL_WSL_DISTRO=__WSL_DISTRO__"

set "SERVER_MJS=%INSTALL_DIR%\broker\server.mjs"

if not exist "%SERVER_MJS%" (
  echo [run-bridge] ERROR: server.mjs not found at "%SERVER_MJS%"
  exit /b 1
)

REM --- Ensure the data dir exists (uploads/exports/logs live here, NOT in web root) ---
if not exist "%HERMES_EXCEL_DATA_DIR%" mkdir "%HERMES_EXCEL_DATA_DIR%" 2>nul

REM --- Stale-bridge killer -------------------------------------------------
REM  Kill only node.exe whose command line names THIS exact absolute server.mjs.
REM  The exact path means re-runs replace the previous owned bridge without
REM  terminating an unrelated Node process elsewhere in the profile.
echo [run-bridge] Stopping any previous bridge from "%INSTALL_DIR%" ...
REM  No WQL -Filter here: the escaped inner quotes get mangled crossing the
REM  cmd->powershell boundary (the '=' is lost, "Invalid query"), which silently
REM  disabled the killer. Single-quoted Where-Object clauses survive intact.
for /f "usebackq tokens=*" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -and $_.CommandLine.IndexOf($env:SERVER_MJS, [StringComparison]::OrdinalIgnoreCase) -ge 0 } | Select-Object -ExpandProperty ProcessId"`) do (
  echo [run-bridge] Killing stale bridge PID %%P
  taskkill /PID %%P /F >nul 2>nul
)

echo [run-bridge] Starting bridge on port %PORT% (docling=%HERMES_EXCEL_DOCLING_MODE%, distro=%HERMES_EXCEL_WSL_DISTRO%)
echo [run-bridge] Data dir: %HERMES_EXCEL_DATA_DIR%

REM --- Launch the bridge on the ABSOLUTE path -----------------------------
node "%SERVER_MJS%"
set "RC=%ERRORLEVEL%"

endlocal & exit /b %RC%
